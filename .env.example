# Telegram Bot (@DealDash_ai_Bot)
TELEGRAM_BOT_TOKEN=replace_me
# Set to your channel username (e.g. @DealDashDeals) or supergroup/channel ID (-1001234567890)
TELEGRAM_CHAT_ID=@YourDealChannel
# Optional admin chat ID for private growth briefings and the agent's post/skip log
ADMIN_CHAT_ID=

# Set AGENT_MODE=false to post the first unseen deals in feed order.
AGENT_MODE=true
# Ask the configured model to choose the slate. Heuristics still run if it fails.
AGENT_LLM=true
# Deals under this score are skipped when something better is available.
AGENT_MIN_SCORE=32

# Bot Controls (Change DRY_RUN=false when ready to post live to Telegram)
DRY_RUN=true
CONTINUOUS=true
POLL_INTERVAL_MINUTES=30
MAX_POSTS_PER_CYCLE=5
POST_DELAY_SECONDS=3
LOG_LEVEL=INFO
DATABASE_PATH=data/state.sqlite3
LOCAL_DEALS_FILE=data/deals.json

# Affiliate Tags (Auto-converts normal Amazon & Flipkart links)
AMAZON_AFFILIATE_TAG=dammaiprasad-21
AMAZON_PARTNER_TAG=dammaiprasad-21
FLIPKART_AFFILIATE_ID=yourflipkartid

# Official APIs (Optional)
FLIPKART_API_ENABLED=false
FLIPKART_AFFILIATE_TOKEN=
AMAZON_API_ENABLED=false

# Automated Deal Feeds
FEEDS_ENABLED=true
MIN_DISCOUNT_PERCENT=30
# Comma-separated extra feeds. Default is r/IndiaDeals. Set to off to disable.
EXTRA_FEED_URLS=https://www.reddit.com/r/IndiaDeals/.rss
# Open the product page before posting. A network error still allows the post.
CHECK_STOCK_BEFORE_POST=true
# Editor refuses a deal under this score instead of posting filler.
AGENT_MIN_SCORE=40

# Gemini stays primary. If the key is empty or the quota is dead, the bot
# calls the free Gemma model on OpenRouter and keeps the same endpoint.
# Leave AI_PROVIDER as gemini. Setting it to hermes skips Gemini entirely.
AI_PROVIDER=gemini

# Google Gemini API
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=12

# Optional Secondary Provider: Groq (Ultra-fast Llama 3.3)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free Gemma backup via OpenRouter. $0, no card.
# Get a key at: https://openrouter.ai/keys
# The Actions secret may be named HERMES_API_KEY, OPENROUTER_API_KEY,
# or DEALS_AGENT_OPENROUTER. Any one of those is the backup key.
# Use the 26B route. Do not set google/gemma-4-31b-it:free (it queues past
# the 12s limit) or openrouter/free (the model changes on every call).
HERMES_API_KEY=
HERMES_MODEL=google/gemma-4-26b-a4b-it:free
HERMES_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# Seasonal Sale Mode ('diwali', 'great_indian_festival', 'prime_day', 'flash', or empty for normal)
SALE_MODE=

# Retailer Filtering (Comma-separated: Amazon,Flipkart or just Amazon)
ALLOWED_RETAILERS=Amazon
