# Telegram Bot (@DealDash_ai_Bot)
TELEGRAM_BOT_TOKEN=replace_me
# Set to your channel username (e.g. @DealDashDeals) or supergroup/channel ID (-1001234567890)\nTELEGRAM_CHAT_ID=@YourDealChannel

# Bot Controls (Change DRY_RUN=false when ready to post live to Telegram)
DRY_RUN=true
CONTINUOUS=true
POLL_INTERVAL_MINUTES=30
MAX_POSTS_PER_CYCLE=5
POST_DELAY_SECONDS=3
LOG_LEVEL=INFO
DATABASE_PATH=data/state.sqlite3
LOCAL_DEALS_FILE=data/deals.json

# Affiliate Tags (Auto-converts normal Amazon & Flipkart links)
AMAZON_PARTNER_TAG=yourtag-21
FLIPKART_AFFILIATE_ID=yourflipkartid

# Official APIs (Optional)
FLIPKART_API_ENABLED=false
FLIPKART_AFFILIATE_TOKEN=
AMAZON_API_ENABLED=false
