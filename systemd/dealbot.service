[Unit]
Description=DealDash AI 24/7 Autonomous Deal Ingestion & Posting Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/DealDash_ai_Bot
EnvironmentFile=/opt/DealDash_ai_Bot/.env
ExecStart=/opt/DealDash_ai_Bot/.venv/bin/python -m dealbot.daemon --healthcheck-server --interval 300
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
